<?xml version="1.0"?>
<robot name="rock">

  <link name="rock_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="tool/sculpt_convex.stl" scale="0.0001 0.0001 0.0001"/>
      </geometry>
      <material name="stone_color">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="tool/sculpt_convex.stl" scale="0.0001 0.0001 0.0001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia
        ixx="0.00061" ixy="0" ixz="0"
        iyy="0.00041" iyz="0"
        izz="0.00071"/>
    </inertial>

  </link>

  <gazebo reference="rock_link">
    <!-- Trenje -->
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

</robot>